BOT_TOKEN=твой_токен_от_ботфатера
GIPHY_TOKEN=не_обязательно_без_него_гифки_из_встроенного_банка
UNSPLASH_ACCESS_KEY=не_обязательно_без_него_фото_с_picsum_не_по_теме

# Telegram ID админов через запятую: 123456,7891011
ADMIN_IDS=1191836733

# ===== НЕ ОБЯЗАТЕЛЬНО: всё это работает само =====
# AUTOSEND: в облаке (Railway) включён сам, локально выключен.
# Укажи off, чтобы выключить и в облаке.
# AUTOSEND=off

# DB_PATH: если к сервису прикреплён volume, Railway сам сообщит путь монтирования,
# и база автоматически ляжет туда (переменная не нужна).
# DB_PATH=db.db

# TIMEZONE для утренних и ночных рассылок (уже по умолчанию Москва)
TIMEZONE=Europe/Moscow

# Интервалы периодических рассылок, в минутах
SEND_GIF_MIN=30
SEND_POEM_MIN=60
SEND_CONFESSION_MIN=120
SEND_PHOTO_MIN=180

# Мемы: каждые MEME_MIN минут бот приносит самый смешной мем.
# Отбор по количеству голосов (upvotes), источник - meme-api.com, ключи не нужны.
# Instagram для этого не используется: чужие посты и их лайки закрыты API,
# а скрейпинг приводит к бану аккаунта.
MEME_MIN=55
MEME_ENABLED=on
# Только русскоязычные мемы: пост без кириллицы в подписи в подборку не берётся
MEME_RUSSIAN_ONLY=on
# Список русскоязычных сабреддитов через запятую
MEME_SUBREDDITS=Pikabu,shitpost_ru,russian_memes,funnyrus
# Порог низкий специально: в русскоязычных сабредитах топ это ~200 голосов,
# а не 40 000 как в англоязычных. С 500 подборка была бы пустая.
MEME_MIN_UPS=20
MEME_POOL_SIZE=12

# ===== УТРЕННЯЯ СВОДКА (погода + курс) =====
# WEATHER_TIME: во сколько присылать. Источник погоды - Open-Meteo,
# курс доллара - официальный API Нацбанка РБ. Оба БЕЗ КЛЮЧЕЙ.
WEATHER_ENABLED=on
WEATHER_TIME=08:30
WEATHER_CITY=Минск
# Город задаётся координатами (Open-Meteo не ищет по названию):
# Минск 53.9006, 27.5590 | Гомель 52.4345, 30.9754 | Брест 52.0976, 23.7341
WEATHER_LAT=53.9006
WEATHER_LON=27.5590
WEATHER_TZ=Europe/Minsk
# Код валюты в справочнике НБ РБ: доллар - 431, евро - 451, рубль РФ - 417
FX_USD_ID=431


# ===== ОТВЕТЫ НА СООБЩЕНИЯ ПОЛЬЗОВАТЕЛЯ =====
# Работают без всяких ключей: сначала собственный движок (счёт, даты, единицы,
# гадание, бытовые вопросы), затем бесплатный Pollinations, и снова свой движок.
AI_ENABLED=on
# DEEPSEEK_API_KEY платный и НЕ обязателен: он лишь ускоряет ответы на сложные
# вопросы и снимает лимит бесплатного канала (1 ответ в 30 секунд на IP).
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# POLLINATIONS_MODEL=openai
# AI_MAX_TOKENS=700
# AI_TIMEOUT=30



# Фиксированные времена (ЧЧ:ММ)
MORNING_TIME=08:00
NIGHT_TIME=22:00

# Тихие часы: ночью периодические рассылки молчат, утро и ночь приходят как обычно
QUIET_HOURS=on
QUIET_FROM=22:30
QUIET_TO=07:30

# Только если подключаешь модуль payments/
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_TOKEN=