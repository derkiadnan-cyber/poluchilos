BOT_TOKEN=твой_токен_от_ботфатера
GIPHY_TOKEN=не_обязательно_без_него_гифки_из_встроенного_банка
UNSPLASH_ACCESS_KEY=не_обязательно_без_него_фото_с_picsum_не_по_теме

# Telegram ID админов через запятую: 123456,7891011
ADMIN_IDS=1191836733

# ===== НЕ ОБЯЗАТЕЛЬНО: всё это работает само =====
# AUTOSEND: в облаке (Railway) включён сам, локально выключен.
# Укажи off, чтобы выключить и в облаке.
# AUTOSEND=off

# DB_PATH: если к сервису прикреплён volume, Railway сам сообщит путь монтирования,
# и база автоматически ляжет туда (переменная не нужна).
# DB_PATH=db.db

# TIMEZONE для утренних и ночных рассылок (уже по умолчанию Москва)
TIMEZONE=Europe/Moscow

# Интервалы периодических рассылок, в минутах
SEND_GIF_MIN=30
SEND_POEM_MIN=60
SEND_CONFESSION_MIN=120
SEND_PHOTO_MIN=180

# Фиксированные времена (ЧЧ:ММ)
MORNING_TIME=08:00
NIGHT_TIME=22:00

# Тихие часы: ночью периодические рассылки молчат, утро и ночь приходят как обычно
QUIET_HOURS=on
QUIET_FROM=22:30
QUIET_TO=07:30

# Только если подключаешь модуль payments/
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_TOKEN=